# Sentinel local development environment
# Copy to .env and fill in values. Never commit real credentials.

# --- Application ---
APP_ENV=development
APP_LOG_LEVEL=info

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel?sslmode=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sentinel-local

# --- Object storage (S3-compatible) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=sentinel-local
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

# --- AI service ---
AI_API_KEY=
AI_MODEL=sentinel-investigator
AI_BASE_URL=https://api.openai.com/v1
AI_SERVICE_URL=http://localhost:8000

# --- API / web ---
PORT=8080
INGESTION_PORT=8090
INGESTION_URL=http://localhost:8090
DETECTION_PORT=8091
DETECTION_URL=http://localhost:8091
INCIDENT_PORT=8092
INCIDENT_URL=http://localhost:8092
REMEDIATION_PORT=8093
REMEDIATION_URL=http://localhost:8093
INCIDENT_CORRELATION_WINDOW_SECONDS=300
ENVIRONMENT=development
LOG_LEVEL=info
AUTH_TOKEN_SECRET=local-dev-token-secret
AUTH_TOKEN_TTL=12h
MIGRATIONS_PATH=database/migrations
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080

# --- Observability ---
# Leave empty unless using: docker compose --profile observability up -d
# Compose services should use http://otel-collector:4318
# Host processes should use http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sentinel
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3002
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
