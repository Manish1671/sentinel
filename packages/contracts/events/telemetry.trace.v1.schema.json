{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.dev/contracts/events/telemetry.trace.v1.json",
  "title": "telemetry.trace",
  "event_type": "telemetry.trace",
  "event_version": 1,
  "topic": "telemetry.events",
  "producer": "services.ingestion",
  "consumers": ["services.detection"],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service_id",
    "service_slug",
    "environment",
    "trace_id",
    "span_id",
    "name",
    "duration_ms",
    "status",
    "occurred_at"
  ],
  "properties": {
    "service_id": { "type": "string", "format": "uuid" },
    "service_slug": { "type": "string" },
    "environment": { "type": "string", "enum": ["production", "staging", "development"] },
    "trace_id": { "type": "string" },
    "span_id": { "type": "string" },
    "parent_span_id": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "duration_ms": { "type": "number", "minimum": 0 },
    "status": { "type": "string", "enum": ["ok", "error", "unset"] },
    "attributes": { "type": "object" },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
