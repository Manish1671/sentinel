{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.dev/contracts/events/incident.created.v1.json",
  "title": "incident.created",
  "event_type": "incident.created",
  "event_version": 1,
  "topic": "incidents.created",
  "producer": "services.incident",
  "consumers": ["apps.api", "services.ai"],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "reference",
    "service_id",
    "title",
    "severity",
    "status",
    "detected_at"
  ],
  "properties": {
    "incident_id": { "type": "string", "format": "uuid" },
    "reference": { "type": "string" },
    "service_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "status": { "type": "string", "enum": ["open"] },
    "alert_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "created_by_user_id": { "type": ["string", "null"], "format": "uuid" },
    "detected_at": { "type": "string", "format": "date-time" },
    "dedup_key": { "type": ["string", "null"] }
  }
}
