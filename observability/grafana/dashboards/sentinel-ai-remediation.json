      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sentinel_remediation_succeeded_total[5m]))",
          "legendFormat": "succeeded"
        },
        {
          "refId": "B",
          "expr": "sum(rate(sentinel_remediation_failed_total[5m]))",
          "legendFormat": "failed"
